# Copy to `.env` in the project root and fill in. Read by the extraction
# pipeline (extraction/) and the dashboard (dashboard/) when run locally.

# --- SQL Server ---------------------------------------------------------------
# Local SQL Server: localhost, with FPL_DB_USER blank for Windows authentication.
# Azure SQL (the hosted site's database): <server>.database.windows.net, the
# server admin login, and FPL_DB_TRUST_CERT=no. See docs/deployment.md.
FPL_DB_SERVER=localhost
FPL_DB_NAME=FPL
FPL_DB_USER=
FPL_DB_PASSWORD=
# odbc (default, Microsoft ODBC Driver 18) or pymssql (no ODBC driver needed).
FPL_DB_DRIVER=odbc
# yes = accept the server's certificate unchecked (local self-signed); no for Azure.
FPL_DB_TRUST_CERT=yes

# --- Pipeline -----------------------------------------------------------------
# Season label stamped on raw rows; must match transformation/seeds/seasons.csv.
FPL_SEASON=2026-27
# Comma-separated FPL manager (entry) IDs to always ingest. Managers looked up
# on the dashboard's My Team page are added automatically and refreshed too.
FPL_ENTRY_IDS=194625

# --- Dashboard ----------------------------------------------------------------
# Manager the "My Team" page opens on (any other ID can be entered there).
FPL_MY_ENTRY_ID=194625
