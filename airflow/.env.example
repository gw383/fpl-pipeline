# Copy to `airflow/.env` and fill in before `docker compose up`.

# SQL Server login used by the extraction scripts and dbt inside the containers
# (the database runs on the host and is reached via host.docker.internal).
FPL_DB_USER=
FPL_DB_PASSWORD=

# Optional pipeline overrides (defaults live in extraction/config.py).
# FPL_SEASON=2026-27
# FPL_ENTRY_IDS=194625

# Airflow's Fernet key, used to encrypt connections/variables at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Optional -- Airflow's own defaults apply when unset.
# AIRFLOW_UID=50000
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow
# AIRFLOW__API_AUTH__JWT_SECRET=
