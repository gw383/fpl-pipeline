# Copy this file to `.env` (same folder, i.e. airflow/.env) and fill
# in real values before running `docker compose up`. Referenced by
# airflow/docker-compose.yaml.

# SQL Server credentials used by the extraction pipeline and the dbt
# profile (airflow/.dbt/profiles.yml) inside the Airflow containers.
FPL_DB_USER=
FPL_DB_PASSWORD=

# Airflow's Fernet key, used to encrypt connections/variables at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Optional overrides -- safe to leave unset, Airflow's own defaults apply.
# AIRFLOW_UID=50000
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow
# AIRFLOW__API_AUTH__JWT_SECRET=
# AIRFLOW__API_AUTH__JWT_ISSUER=airflow
