# Settings for the hosted dashboard. On Streamlit Community Cloud, paste
# these (with real values) into the app's Settings -> Secrets. Locally you
# can instead copy this file to secrets.toml (never commit it) or keep using
# the project's .env.
#
# The pages read the published data file and need none of this. The database
# login is only used by the My Team page, to look up a manager who isn't in
# the file yet; without it, only saved managers can be shown.

FPL_DB_DRIVER = "pymssql"
FPL_DB_SERVER = "<your-server>.database.windows.net"
FPL_DB_NAME = "fpl"
FPL_DB_USER = "fpl_web"
FPL_DB_PASSWORD = "<the fpl_web password>"
FPL_DB_TRUST_CERT = "no"

# Manager the My Team page opens on.
FPL_MY_ENTRY_ID = "194625"

# Optional: read a data file from somewhere other than this repository's
# "data" branch (a gzipped fpl_serving.sqlite).
# FPL_DATA_URL = "https://example.com/fpl_serving.sqlite.gz"
