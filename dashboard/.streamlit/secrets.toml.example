# Settings for the hosted dashboard. On Streamlit Community Cloud, paste
# these (with real values) into the app's Settings -> Secrets. Locally you
# can instead copy this file to secrets.toml (never commit it) or keep using
# the project's .env.

FPL_DB_DRIVER = "pymssql"
FPL_DB_SERVER = "<your-server>.database.windows.net"
FPL_DB_NAME = "fpl"
FPL_DB_USER = "fpl_web"
FPL_DB_PASSWORD = "<the fpl_web password>"
FPL_DB_TRUST_CERT = "no"

# Manager the My Team page opens on.
FPL_MY_ENTRY_ID = "194625"
